listen: :443

tls:
  cert: /etc/hysteria/certs/fullchain.pem
  key: /etc/hysteria/certs/privkey.pem

auth:
  type: http
  http:
    url: http://nest-app:5000/internal/hysteria/auth
    insecure: true

trafficStats:
  listen: :9999
  secret: "{{TRAFFIC_STATS_SECRET}}"

masquerade:
  type: proxy
  proxy:
    url: {{MASQUERADE_URL}}

bandwidth:
  up: {{BANDWIDTH_UP}}
  down: {{BANDWIDTH_DOWN}}

outbounds:
  - name: to_exit
    type: socks5
    socks5:
      addr: hysteria-exit-{{NODE_NAME}}:1080
