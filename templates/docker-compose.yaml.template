version: "3.9"

networks:
  instance-network:
    name: instance-network

services:
  nginx:
    image: nginx:alpine
    container_name: nginx-proxy-{{NODE_NAME}}
    restart: always
    ports:
      - "80:80"
      - "8080:8080"
    volumes:
      - {{ROOT}}/generated/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ROOT}}/nginx-certs:/etc/nginx/certs:ro
      - {{ROOT}}/index.html:/etc/nginx/html/index.html:ro
    networks:
      - instance-network

  xray:
    image: teddysun/xray
    container_name: xray-{{NODE_NAME}}
    restart: always
    ports:
      - "443:443"
    volumes:
      - {{ROOT}}/generated/xray-config.json:/etc/xray/config.json:ro
    command: xray run -config /etc/xray/config.json
    depends_on:
      - nginx
    networks:
      - instance-network

  nest-app:
    container_name: nest-app-{{NODE_NAME}}
    restart: always
    build:
      context: {{ROOT}}
      dockerfile: Dockerfile.nestjs
    env_file:
      - {{ROOT}}/generated/.env
    networks:
      - instance-network

  promtail:
    image: grafana/promtail:latest
    container_name: promtail-{{NODE_NAME}}
    restart: unless-stopped
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ROOT}}/promtail-config.yaml:/etc/promtail/config.yml
    command: -config.file=/etc/promtail/config.yml
    privileged: true
    networks:
      - instance-network
