version: "3.9"

networks:
  instance-network:
    name: instance-network

services:
  nginx:
    image: nginx:alpine
    container_name: nginx-proxy-{{NODE_NAME}}
    restart: always
    ports:
      - "80:80"
      - "{{CONTROL_PORT}}:{{CONTROL_PORT}}"
    volumes:
      - {{ROOT}}/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ROOT}}/generated/nginx:/etc/nginx/conf.d/nodes:ro
      - {{ROOT}}/nginx-certs:/etc/nginx/certs:ro
      - {{ROOT}}/index.html:/etc/nginx/html/index.html:ro
    networks:
      - instance-network

  redis:
    image: redis:7-alpine
    container_name: redis-{{NODE_NAME}}
    restart: unless-stopped
    command: redis-server --save "" --appendonly no
    networks:
      - instance-network

  hysteria-exit:
    image: tobyxdd/hysteria:latest
    container_name: hysteria-exit-{{NODE_NAME}}
    hostname: hysteria-exit-{{NODE_NAME}}
    restart: unless-stopped
    volumes:
      - {{ROOT}}/generated/hysteria-exit-client.yaml:/etc/hysteria/config.yaml:ro
    command: client -c /etc/hysteria/config.yaml
    networks:
      instance-network:
        aliases:
          - hysteria-exit-{{NODE_NAME}}

  nest-app:
    container_name: nest-app-{{NODE_NAME}}
    restart: always
    build:
      context: {{ROOT}}
      dockerfile: Dockerfile.nestjs
    env_file:
      - {{ROOT}}/generated/.env
    networks:
      - instance-network
    depends_on:
      - redis

  hysteria:
    image: tobyxdd/hysteria:latest
    container_name: hysteria-{{NODE_NAME}}
    restart: unless-stopped
    ports:
      - "{{LISTEN_PORT}}:{{LISTEN_PORT}}/udp"
      - "{{LISTEN_PORT}}:{{LISTEN_PORT}}/tcp"
    volumes:
      - {{ROOT}}/generated/hysteria-server-config.yaml:/etc/hysteria/config.yaml:ro
      - {{ROOT}}/nginx-certs:/etc/hysteria/certs:ro
    command: server -c /etc/hysteria/config.yaml
    networks:
      - instance-network
    depends_on:
      - nest-app
      - hysteria-exit

  promtail:
    image: grafana/promtail:latest
    container_name: promtail-{{NODE_NAME}}
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ROOT}}/promtail-config.yaml:/etc/promtail/config.yml
    command: -config.file=/etc/promtail/config.yml
    privileged: true
    networks:
      - instance-network
